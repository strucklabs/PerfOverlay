<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Nur für das Tray-Icon (NotifyIcon) -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>PerfOverlay</AssemblyName>
    <RootNamespace>PerfOverlay</RootNamespace>
    <Version>0.1.0</Version>
    <!-- WinForms-Analyzer will DPI-Einstellungen per API; für WPF gehört das ins Manifest -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms-Namespaces kollidieren mit WPF (Application, Color, Point ...) -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <!-- Wird als eigener Prozess gestartet, darf also nicht in eine Single-File-EXE gebündelt werden -->
    <None Update="tools\PresentMon.exe" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

</Project>
